<mvc:View
    controllerName="kbeauty.controller.Main"
    height="100%"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdcvh="sap.ui.mdc.valuehelp"
    xmlns:mdcvhc="sap.ui.mdc.valuehelp.content"
    xmlns:vm="sap.ui.fl.variants"
    xmlns:uit="sap.ui.table">

    <f:DynamicPage id="page" fitContentWithPadding="true">
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <HBox id="idHeaderHBox" alignItems="Center">
                        <Title 
                            id="idTitleHeader" 
                            text="KBeauty Product Management" 
                            level="H2" 
                            titleStyle="H2" 
                            class="HeaderTitle sapUiSmallMarginEnd"/>
                        <vm:VariantManagement id="variants" for="filterbar, productTable"/>
                    </HBox>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader" pinnable="true">
                <mdc:FilterBar 
                    id="filterbar" 
                    delegate="{ name: 'sap/ui/mdc/FilterBarDelegate' }"
                    p13nMode="Item,Value"
                    search=".onFilterSearch"
                    class="customMdcFilterBar">
                    
                    <mdc:basicSearchField>
                        <mdc:FilterField 
                            id="idBasicSearch"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate'}"
                            dataType="sap.ui.model.type.String"
                            placeholder="Product Name"
                            conditions="{$filters>/conditions/$search}"
                            propertyKey="$search"
                            maxConditions="1"/>
                    </mdc:basicSearchField>

                    <mdc:filterItems>
                        <mdc:FilterField
                            id="ffBrand"
                            label="브랜드"
                            propertyKey="brand/name"
                            dataType="sap.ui.model.type.String"
                            conditions="{$filters>/conditions/brand/name}"
                            valueHelp="vhBrand"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate'}"/>

                        <mdc:FilterField
                            id="ffCategory"
                            label="카테고리"
                            propertyKey="category/name"
                            dataType="sap.ui.model.type.String"
                            conditions="{$filters>/conditions/category/name}"
                            valueHelp="vhCategory"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate'}"/>
                    </mdc:filterItems>

                    <mdc:dependents>
                        <mdc:ValueHelp id="vhBrand">
                            <mdc:dialog>
                                <mdcvh:Dialog id="dlgBrand" title="Select Brand">
                                    <mdcvhc:MTable
                                        id="vhContentBrandTable"
                                        title="Brands"
                                        keyPath="ID"
                                        descriptionPath="name">
                                        <mdcvhc:table>
                                            <Table 
                                                id="tblBrandVH"
                                                items="{ path: '/Brands' }">
                                                <columns>
                                                    <Column id="colVhBrandId"><Text id="txtColVhBrandId" text="ID"/></Column>
                                                    <Column id="colVhBrandName"><Text id="txtColVhBrandName" text="Brand Name"/></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem id="itemVhBrand" type="Active">
                                                        <cells>
                                                            <Text id="txtCellVhBrandId" text="{ID}"/>
                                                            <Text id="txtCellVhBrandName" text="{name}"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </mdcvhc:table>
                                    </mdcvhc:MTable>
                                    <mdcvhc:Conditions id="vhContentBrandCond" title="Define Conditions"/>
                                </mdcvh:Dialog>
                            </mdc:dialog>
                        </mdc:ValueHelp>

                        <mdc:ValueHelp id="vhCategory">
                            <mdc:dialog>
                                <mdcvh:Dialog id="dlgCategory" title="Select Category">
                                    <mdcvhc:MTable
                                        id="vhContentCategoryTable"
                                        title="Categories"
                                        keyPath="ID"
                                        descriptionPath="name">
                                        <mdcvhc:table>
                                            <Table 
                                                id="tblCategoryVH"
                                                items="{ path: '/Categories' }">
                                                <columns>
                                                    <Column id="colVhCatId"><Text id="txtColVhCatId" text="ID"/></Column>
                                                    <Column id="colVhCatName"><Text id="txtColVhCatName" text="Category Name"/></Column>
                                                </columns>
                                                <items>
                                                    <ColumnListItem id="itemVhCategory" type="Active">
                                                        <cells>
                                                            <Text id="txtCellVhCatId" text="{ID}"/>
                                                            <Text id="txtCellVhCatName" text="{name}"/>
                                                        </cells>
                                                    </ColumnListItem>
                                                </items>
                                            </Table>
                                        </mdcvhc:table>
                                    </mdcvhc:MTable>
                                    <mdcvhc:Conditions id="vhContentCategoryCond" title="Define Conditions"/>
                                </mdcvh:Dialog>
                            </mdc:dialog>
                        </mdc:ValueHelp>
                    </mdc:dependents>
                </mdc:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <uit:Table
                id="productTable"
                rows="{
                    path: '/Products',
                    parameters: {
                        $expand: 'brand,category'
                    }
                }"
                selectionMode="MultiToggle"
                visibleRowCountMode="Auto"
                rowActionCount="1">
                <uit:extension>
                    <OverflowToolbar id="idTableToolbar">
                        <Title id="idTableTitle" text="PRODUCTS INFORMATION" level="H2" class="customTitleColor"/>
                        <ToolbarSpacer id="tbSpacer"/>
                        <Button 
                            id="idBtnAddProduct"
                            text="Add Product"
                            type="Emphasized"
                            press=".onAddProductPress"/>
                    </OverflowToolbar>
                </uit:extension>

                <uit:columns>
                    <uit:Column id="colID" width="9rem" hAlign="Center">
                        <Label id="lblColID" text="상품 코드 (ID)" />
                        <uit:template>
                            <Text id="txtCellID" text="{ID}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colName" width="12rem" hAlign="Center">
                        <Label id="lblColName" text="상품명" />
                        <uit:template>
                            <Text id="txtCellName" text="{name}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colPrice" width="9rem" hAlign="Center">
                        <Label id="lblColPrice" text="가격" />
                        <uit:template>
                            <Text id="txtCellPrice" text="₩ {price}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colStock" width="6rem" hAlign="Center">
                        <Label id="lblColStock" text="재고 수량" />
                        <uit:template>
                            <ObjectStatus 
                                id="objStatusStock" 
                                text="{stock}" 
                                state="{= Number(${stock}) === 0 ? 'Error' : (Number(${stock}) &lt;= 20 ? 'Warning' : 'Success')}" />
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colStatus" width="9rem" hAlign="Center">
                        <Label id="lblColStatus" text="상태" />
                        <uit:template>
                            <ObjectStatus 
                                id="objStatus"
                                text="{= Number(${stock}) === 0 ? 'OutOfStock' : (Number(${stock}) &lt;= 20 ? 'Warning' : 'Success')}"
                                state="{= Number(${stock}) === 0 ? 'Error' : (Number(${stock}) &lt;= 20 ? 'Warning' : 'Success')}" />
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colMainExpiryMonth" width="6rem" hAlign="Center">
                        <Label id="lblColMainExpiryMonth" text="유통기한 (월)" />
                        <uit:template>
                            <Text id="txtCellExpiryMonth" text="{expiryMonth}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colBrand" width="9rem" hAlign="Center">
                        <Label id="lblColBrand" text="브랜드" />
                        <uit:template>
                            <Text id="txtCellBrand" text="{brand/name}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colCategory" width="9rem" hAlign="Center">
                        <Label id="lblColCategory" text="카테고리" />
                        <uit:template>
                            <Text id="txtCellCategory" text="{category/name}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>

                    <uit:Column id="colMainDescription" width="12rem" hAlign="Center">
                        <Label id="lblColMainDescription" text="상세 설명" />
                        <uit:template>
                            <Text id="txtCellDescription" text="{description}" wrapping="false"/>
                        </uit:template>
                    </uit:Column>
                </uit:columns>

                <uit:rowActionTemplate>
                    <uit:RowAction id="idRowAction">
                        <uit:items>
                            <uit:RowActionItem
                                id="idRowActionItemNav"
                                type="Navigation"
                                press=".onRowNavigationPress" />
                        </uit:items>
                    </uit:RowAction>
                </uit:rowActionTemplate>
            </uit:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>