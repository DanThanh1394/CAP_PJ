{
  "_version": "1.86.0",
  "sap.app": {
    "id": "kbeauty",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.30.0",
      "toolsId": "d3e75eae-6395-4966-a623-e81e640524b1"
    },
    "dataSources": {
      "mainService": {
        "uri": "/ThanhTD68/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.table": {},
        "sap.ui.mdc": {},
        "sap.ui.fl": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "kbeauty.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "updateGroupId": "myUpdateGroup"
        }
      },
      "$filters": {
        "type": "sap.ui.model.json.JSONModel",
        "data": {
          "conditions": {}
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "kbeauty.view",
        "async": true,
        "viewPath": "kbeauty.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        },
        {
      "name": "RouteDetail",
      "pattern": "Products({productId})",
      "target": [
        "TargetDetail"
          ]
        },
        {
          "name": "RouteManage",
          "pattern": "manage",
          "target": [
            "TargetManage"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetDetail": {
        "id": "Detail",
        "name": "Detail"
      },
        "TargetManage": {
      "id": "Manage",
      "name": "Manage"
      }
      }
    },
    "rootView": {
      "viewName": "kbeauty.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}