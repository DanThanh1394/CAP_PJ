<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <TableSelectDialog
        id="idTechSelectDialog"
        title="Select Technician (Matching Skill Only)"
        search="onDialogSearch"
        confirm="onDialogConfirm"
        cancel="onDialogCancel"
        items="{path: '/Technicians'}">
        <columns>
            <Column id="diagColTechID"><Text id="txtTechIDHeader" text="ID"/></Column>
            <Column id="diagColTechName"><Text id="txtTechNameHeader" text="Name"/></Column>
            <Column id="colDialogTechSkill"><Text id="txtTechSkillHeader" text="Skill"/></Column>
            <Column id="colTechWorkCenter"><Text id="txtTechWorkCenterHeader" text="Work Center"/></Column>
            <Column id="colTechAvail"><Text id="txtTechAvailHeader" text="Available"/></Column>
        </columns>
        <items>
            <ColumnListItem id="diagCliTechRow">
                <cells>
                    <Text id="txtDialogTechID" text="{ID}"/>
                    <Text id="txtDialogTechName" text="{Name}"/>
                    <Text id="txtDialogTechSkill" text="{Skill}"/>
                    <Text id="txtDialogTechWC" text="{WorkCenter}"/>
                    <Text id="txtDialogTechAvail" text="{Available}"/>
                </cells>
            </ColumnListItem>
        </items>
    </TableSelectDialog>
</core:FragmentDefinition>